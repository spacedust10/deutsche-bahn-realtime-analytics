# ---------------------------------------------------------------------------
# Realtime source
# ---------------------------------------------------------------------------
# Primary source is the OFFICIAL DB Fernverkehr GTFS-RT feed, which is
# key-gated. Request access via ris-gtfs@deutschebahn.com and set the key here.
# With DB_API_KEY set, the collector uses the official DB endpoints below.
DB_API_KEY=

DB_GTFS_RT_URL=https://gtfs-datenstroeme.tech.deutschebahn.com/db-fernverkehr/gtfsrt_trip_updates.proto
DB_GTFS_ALERTS_URL=https://gtfs-datenstroeme.tech.deutschebahn.com/db-fernverkehr/gtfsrt_service_alerts.proto
DB_GTFS_STATIC_URL=https://gtfs-datenstroeme.tech.deutschebahn.com/db-fernverkehr/gtfs.zip

# Open fallback used when DB_API_KEY is empty, so the pipeline runs for anyone.
# CC BY-SA 4.0, derived from the DELFI NeTEx dataset, updated every 10s.
FALLBACK_GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb
FALLBACK_GTFS_STATIC_URL=https://download.gtfs.de/germany/fv_free/latest.zip

# Seconds between polls. DB documents 20s for the official feed; the open
# fallback ships all of Germany (~45 MB) so it defaults slower.
POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=dbrt
PGUSER=
PGPASSWORD=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
